# Copia este archivo como backend/.env y pon tu clave real.
# Obtén tu API key en: https://console.anthropic.com/
#
# Esta clave vive solo en el servidor — nunca la pongas en el .env de la
# raíz del proyecto ni con el prefijo VITE_, o quedará expuesta en el
# JavaScript que se sirve al navegador.

ANTHROPIC_API_KEY=sk-ant-api03-...

# Envío de correo (notificación al Jefe cuando alguien crea un pedido en
# Inventario → Pedidos) — cuenta Gmail + contraseña de aplicación (no la
# contraseña normal; se genera en myaccount.google.com/apppasswords, requiere
# verificación en 2 pasos activada en esa cuenta).
EMAIL_USER=operaciones@tierraprometidat.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
JEFE_EMAIL=correo-del-jefe@ejemplo.com
